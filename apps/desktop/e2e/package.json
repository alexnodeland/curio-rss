{
    "name": "curio-desktop-e2e",
    "private": true,
    "version": "0.2.0",
    "description": "WebdriverIO + tauri-driver smoke suite for the Curio desktop head (Linux + Windows; there is no macOS tauri-driver). Self-contained: installed (npm ci, from its own lockfile) only by the nightly smoke job, never by the per-PR gates.",
    "type": "module",
    "scripts": {
        "test": "wdio run ./wdio.conf.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@wdio/cli": "^9.32.0",
        "@wdio/globals": "^9.31.3",
        "@wdio/local-runner": "^9.32.0",
        "@wdio/mocha-framework": "^9.32.0",
        "@wdio/spec-reporter": "^9.32.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "tsx": "^4.23.0",
        "typescript": "^5.3.0",
        "webdriverio": "^9.32.0",
        "yaml": "^2.9.0"
    }
}
